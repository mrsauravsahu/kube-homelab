flags:
  rewrite: false

cert:
  issuer: letsencrypt-prod-homelab
  secretName: letsencrypt-prod-cert-secret-owncloud

service:
  name: owncloud
  port:
    number: 80

annotations:
  hajimari.io/enable: "true"
  hajimari.io/appName: "owncloud"
  nginx.ingress.kubernetes.io/proxy-body-size: "0"
  nginx.ingress.kubernetes.io/proxy-request-buffering: "off"
  nginx.ingress.kubernetes.io/proxy-read-timeout: "600"
  nginx.ingress.kubernetes.io/proxy-send-timeout: "600"

ingress:
  name: owncloud
  enableLocalDomains: false
  subdomain: owncloud
  routePath: /

hosts:
#%{ for host in hosts ~}
#- name: ${host}
#%{ endfor ~}
  - name: "mrsauravsahu.in"
